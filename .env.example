# ROADGUARD AI — local development environment template
# Copy to .env and replace every placeholder. Never commit the real .env.
#
# All values below are LOCAL DEVELOPMENT placeholders. Generate fresh secrets for
# any shared or deployed environment.

ENVIRONMENT=development
API_PORT=8000
WEB_PORT=3000
LOG_LEVEL=INFO

# --- Security ---
# REQUIRED. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-long-random-value
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# Set true only when serving over HTTPS.
COOKIE_SECURE=false
COOKIE_DOMAIN=
# Comma-separated browser origins allowed to call the API with credentials.
ALLOWED_ORIGINS=http://localhost:3000
LOGIN_RATE_LIMIT_PER_MINUTE=10

# --- Database (PostgreSQL + PostGIS) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=roadguard
POSTGRES_USER=roadguard
POSTGRES_PASSWORD=local-dev-postgres-superuser-password
POSTGRES_APP_USER=roadguard_app
POSTGRES_APP_PASSWORD=local-dev-app-role-password

# Privileged role: migrations + seeding only.
DATABASE_MIGRATION_URL=postgresql+psycopg://roadguard:local-dev-postgres-superuser-password@localhost:5432/roadguard
# Runtime role used by the API: subject to Row-Level Security.
DATABASE_APP_URL=postgresql+psycopg://roadguard_app:local-dev-app-role-password@localhost:5432/roadguard
# TLS for managed databases. Local containers accept "prefer"; Supabase needs "require".
DATABASE_SSL_MODE=prefer
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# --- Supabase (managed PostgreSQL + PostGIS) ---
# Two different strings, two different jobs. See docs/SUPABASE.md.
#
# 1) DIRECT / session connection (port 5432): migrations, seeding, smoke runs.
#    Copy from Supabase -> Project -> Connect -> Direct connection.
# 2) TRANSACTION POOLER (port 6543): the API and worker at runtime.
#    Copy from Connect -> Connection pooling -> Transaction. It may include
#    ?pgbouncer=true; the loader strips that before libpq sees it.
#
# Both need ?sslmode=require (or verify-full). The loader refuses an unencrypted
# connection to a Supabase host or the pooler instead of silently downgrading.
#
#   python scripts/supabase_setup.py \
#       --url "$SUPABASE_DB_URL" --app-url "$SUPABASE_POOLER_URL" \
#       --bootstrap --write-env --migrate
#
# The script creates the RLS role, extensions, grants, rewrites the DATABASE_* and
# COMPOSE_DATABASE_* entries below, and migrates over the DIRECT URL only.
SUPABASE_DB_URL=
SUPABASE_POOLER_URL=
# Container-only overrides: inside Compose, localhost is not the host machine.
# Migration/seed must use 5432; runtime must use 6543.
COMPOSE_DATABASE_MIGRATION_URL=
COMPOSE_DATABASE_APP_URL=

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
# polling = in-repo claim/lease worker (no Redis needed); celery = Celery worker.
JOB_RUNNER=polling
JOB_MAX_ATTEMPTS=3
JOB_LEASE_SECONDS=900

# --- Private object storage ---
# local = private directory on the API host with signed API upload/download URLs.
# s3    = MinIO or any S3-compatible private bucket.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minio-local-dev
S3_SECRET_ACCESS_KEY=local-dev-minio-secret
S3_BUCKET=roadguard-private
S3_REGION=us-east-1
SIGNED_URL_TTL_SECONDS=900

# --- Video ingestion limits ---
MAX_UPLOAD_BYTES=209715200
MAX_VIDEO_DURATION_SECONDS=600
MAX_VIDEO_WIDTH=3840
MAX_VIDEO_HEIGHT=2160
VIDEO_RETENTION_DAYS=30

# --- AI pipeline ---
# synthetic_scene = colour-marker detector for the generated synthetic demo clip.
# yolo            = ultralytics YOLO adapter (requires optional extra install).
DETECTOR_BACKEND=synthetic_scene
YOLO_WEIGHTS=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.35
FRAME_SAMPLE_FPS=5
TRACKER=max_iou
# Near-miss candidate rule thresholds (rule version near_miss_v1 / 1.0.0)
NEAR_MISS_PROXIMITY_RATIO=0.55
NEAR_MISS_CONVERGENCE_WINDOW_SECONDS=2.0
NEAR_MISS_MIN_TRACK_FRAMES=5

# --- Live CCTV adapter (disabled by default; requires authorization) ---
LIVE_CCTV_ENABLED=false
LIVE_CCTV_ALLOWED_HOSTS=
LIVE_CCTV_ALLOWED_CIDRS=

# --- Optional LLM investigation assistant (application works without it) ---
LLM_PROVIDER=none
LLM_MODEL=
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30

# --- Frontend ---
# Browser-visible values only. Never put secrets here.
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# Browser-reachable endpoint used to sign object URLs (compose: http://localhost:9000)
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
