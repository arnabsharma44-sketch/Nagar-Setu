# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/
.coverage.*

# Node
node_modules/
.next/
out/
dist/
*.tsbuildinfo
.next-env.d.ts

# Local runtime artifacts
storage/
local_storage/
*.log
logs/
celerybeat-schedule*

# Generated demo media (regenerated by scripts/generate_demo_clip.py)
datasets/sample_videos/*.mp4
datasets/sample_videos/*.json
!datasets/sample_videos/.gitkeep

# Model weights
*.pt
*.onnx

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Operator footage and generated provenance manifests must never be committed.
datasets/incoming/*
!datasets/incoming/README.md
datasets/manifests/*.json

# External datasets: archives, extracted content and model weights never enter git.
datasets/external/*/raw/*
!datasets/external/*/raw/.gitkeep
datasets/external/*/extracted/
datasets/external/*/annotations/*
!datasets/external/*/annotations/.gitkeep
datasets/external/*/images/*
!datasets/external/*/images/.gitkeep
datasets/external/*/labels/*
!datasets/external/*/labels/.gitkeep
datasets/external/*/processed/*
!datasets/external/*/processed/.gitkeep
datasets/reports/*
!datasets/reports/.gitkeep
datasets/fixtures/**/*.mp4
datasets/fixtures/**/*.avi
datasets/fixtures/**/*.mov
datasets/fixtures/**/frames/
*.pt
*.pth
*.onnx

# Generated dataset fixtures (recreate with scripts/datasets/build_fixtures.py)
datasets/fixtures/rdd2022_mini/

# Local Supabase-shaped verification certificates and credentials
infrastructure/supabase/certs/
infrastructure/supabase/pgbouncer/userlist.txt

# Local Supabase-shaped runtime storage
storage-supabase/
